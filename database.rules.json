{
  "rules": {
    "liveTracking": {
      ".read": true,
      ".write": false,
      "$trackingId": {
        ".write": "(!newData.exists() && (auth != null || data.child('donorId').val().beginsWith('guest_'))) || (newData.exists() && newData.child('donorId').isString() && ((auth != null && newData.child('donorId').val() === auth.uid) || newData.child('donorId').val().beginsWith('guest_')))",
        ".validate": "!newData.exists() || newData.hasChildren(['donorId', 'requestId', 'status'])"
      }
    }
  }
}
