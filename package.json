{
  "name": "lifelink",
  "private": false,
  "version": "1.0.0",
  "description": "Connected Lives Vietnam - Emergency Blood Donor Coordination Platform",
  "author": "LifeLink Project Authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/COS30043/LifeLink.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lifelink \"vitest run tests/rules\"",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@maplibre/maplibre-gl-leaflet": "github:maplibre/maplibre-gl-leaflet",
    "bootstrap": "^5.3.8",
    "firebase": "^12.15.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "motion": "^12.42.2",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "bootstrap-icons": "^1.13.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "terser": "^5.39.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
